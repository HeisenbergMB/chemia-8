{
  "permissions": {
    "allow": [
      "Bash(npm run verify)",
      "Bash(npm run check)",
      "Bash(npm run build)",
      "Bash(npm run bump)",
      "Bash(npm run lock)",
      "Bash(npm test)",
      "Bash(node tools/check-data.js)",
      "Bash(node tools/build.js:*)",
      "Bash(node tools/lock-ids.js:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-data.sh" }]
      }
    ]
  }
}
